# GitHub OAuth App credentials
# Create at https://github.com/settings/developers
# Callback URL for dev: http://localhost:3000/api/auth/github/callback
# Callback URL for prod: https://your-domain.example/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Canonical public origin of the app. Required in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Key used to encrypt the session cookie. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
